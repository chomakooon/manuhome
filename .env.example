# Public browser configuration only. Never put service-role, Stripe secret,
# OpenRouter, or notification webhook credentials in VITE_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server secrets and deployment sequence: docs/commerce-deployment.md
# Stripe Checkout is created server-side; no browser Stripe key is needed.
